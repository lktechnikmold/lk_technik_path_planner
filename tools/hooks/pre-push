#!/bin/sh
# Führt vor jedem Push alle Tests des Plugins unter QGIS 3 und QGIS 4 aus.
# Schlägt ein Test fehl, wird der Push abgebrochen.
#
# Einmalig aktivieren (im Repo-Ordner):
#     git config core.hooksPath tools/hooks

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-push: Tests werden ausgeführt (QGIS 3 und QGIS 4) ..."
cmd.exe //c "tests\\run_tests.bat"
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "pre-push: Tests fehlgeschlagen - Push abgebrochen."
    exit 1
fi
echo "pre-push: alle Tests bestanden."
exit 0
